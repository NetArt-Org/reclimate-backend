# Copy to .env and fill in. Never commit .env.

# Neon → Project → Connect → "Pooled connection" string (keep ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Any long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Origins allowed to call the API (comma separated).
#   http://localhost:3000   the app in the browser (npm run dev)
#   capacitor://localhost   the iOS app
#   https://localhost       the Android app
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,https://localhost

# Public address of this server (no trailing slash). Set it when you deploy.
SERVER_URL=http://localhost:3001

# Only when the app and this server are on unrelated domains (needs HTTPS): None
# COOKIE_SAMESITE=Strict

# Used once by `npm run seed` to create the demo accounts.
SEED_ADMIN_PASSWORD=
# PIN for the demo worker and supervisors (the app's login screen has 4 boxes).
SEED_DEMO_PIN=
