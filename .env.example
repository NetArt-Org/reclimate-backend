# Template for the backend's two env files (this one is committed; the real ones are git-ignored and hold secrets):
#   .env.development   LOCAL       npm run dev, and every script (migrate, import:circonomy, media:copy, …)
#   .env.production    PRODUCTION  npm run build / npm start, and scripts run with NODE_ENV=production
# Copy this file to both and fill in the values.
#
# Scripts use the LOCAL file unless you ask for production on purpose, e.g.
#   NODE_ENV=production npm run media:copy     ← writes to the live database and storage
#
# The live backend (Firebase App Hosting) does not read these files: its values are set in
# App Hosting → reclimate-backend → Settings → Environment, plus the non-secret ones in apphosting.yaml.
# .env.production is your reference copy of what is set there.

# ---- Database ----------------------------------------------------------------------------------------------------
# SECRET.  Local: the embedded test Postgres, postgresql://reclimate:localtest@localhost:5433/reclimate
#          Production: the Neon connection string (Neon console → Connect), with ?sslmode=require
DATABASE_URL=
# SECRET. Any long random string (openssl rand -hex 32); use a different one locally and in production.
PAYLOAD_SECRET=

# ---- Addresses ---------------------------------------------------------------------------------------------------
# Local: http://localhost:3001     Production: https://reclimate-backend--reclimate-d0868.asia-southeast1.hosted.app
SERVER_URL=
# Who may call the field API from a browser/app. Android app: https://localhost   iOS app: capacitor://localhost
#   Local:      http://localhost:3000,https://localhost,capacitor://localhost
#   Production: https://localhost,capacitor://localhost,https://reclimate-frontend.vercel.app
CORS_ORIGINS=

# ---- Firebase web config (public by design; the same in both files) ----------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=reclimate-d0868.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=reclimate-d0868
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=reclimate-d0868.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (SECRET: a service-account key) -------------------------------------------------------------
# Firebase console → Project settings → Service accounts → Generate new private key; copy three fields from the JSON.
# Keep FIREBASE_PRIVATE_KEY on one line with \n for the line breaks. In the App Hosting console paste it WITHOUT quotes.
FIREBASE_PROJECT_ID=reclimate-d0868
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Access and abuse protection ---------------------------------------------------------------------------------
# Google addresses that become admins on their first sign-in (comma separated); only needed for the first admin.
ADMIN_EMAILS=
# Firebase App Check for the field API: off | monitor | enforce (see src/field/appcheck.ts)
APP_CHECK=off
# Oldest app version the field API still serves, e.g. 2.7.0. Leave out to serve every version.
# MIN_APP_VERSION=
# X-Forwarded-For entries counted from the right to find the caller (only when x-fah-client-ip is absent). Default 2.
# TRUST_PROXY_HOPS=2
